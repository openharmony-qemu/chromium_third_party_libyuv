diff a/source/rotate_neon.cc b/source/rotate_neon.cc	(rejected hunks)
@@ -196,20 +196,20 @@ void Transpose4x4_32_NEON(const uint8_t* src,
       "vst1.8      {q1}, [%5]!                   \n"
       "vst1.8      {q2}, [%6]!                   \n"
       "vst1.8      {q3}, [%7]!                   \n"
       "bgt         1b                            \n"
 
-      : "+r"(src),                        // %0
-        "+r"(src1),                       // %1
-        "+r"(src2),                       // %2
-        "+r"(src3),                       // %3
-        "+r"(dst),                        // %4
-        "+r"(dst1),                       // %5
-        "+r"(dst2),                       // %6
-        "+r"(dst3),                       // %7
-        "+r"(width)                       // %8
-      : "r"((ptrdiff_t)(src_stride * 4))  // %9
+      : "+r"(src),                      // %0
+        "+r"(src1),                     // %1
+        "+r"(src2),                     // %2
+        "+r"(src3),                     // %3
+        "+r"(dst),                      // %4
+        "+r"(dst1),                     // %5
+        "+r"(dst2),                     // %6
+        "+r"(dst3),                     // %7
+        "+r"(width)                     // %8
+      : "r"((ptrdiff_t)src_stride * 4)  // %9
       : "memory", "cc", "q0", "q1", "q2", "q3");
 }
 
 #endif  // defined(__ARM_NEON__) && !defined(__aarch64__)
 
