     public_configs = [ ":libyuv_config" ]
 
     # The -march arguments below are incompatible with libc++ modules.
     use_libcxx_modules = false
     if (current_cpu == "arm64") {
+      if (!enable_cfi_protection) {
       cflags = [ "-march=armv8-a+dotprod+i8mm" ]
+    } else {
+        configs -= [ "//arkweb/build/config/sanitizers:armv83a" ]
+        cflags = [ "-march=armv8-a+pauth-hint-only+dotprod+i8mm" ]
+      }
     } else {
       configs -= [ "//build/config/compiler:compiler_arm_fpu" ]
       cflags = [ "-mfpu=neon" ]
     }
   }
@@ -250,11 +256,16 @@ if (libyuv_use_sve) {
 
     # The -march arguments below are incompatible with libc++ modules.
     use_libcxx_modules = false
 
